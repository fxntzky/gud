# Existing private Vercel Blob integration (never commit a real token)
BLOB_READ_WRITE_TOKEN=
# Required for scheduled generation. Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Dashboard access (at least 16 strong ASCII chars). Prefer additional Vercel WAF / deployment protection.
GUD_ADMIN_PASSWORD=
# Paid audit is disabled until explicitly configured.
GUD_LLM_ENABLED=false
OPENAI_API_KEY=
GUD_LLM_MODEL=gpt-4.1-nano
GUD_MAX_AUDIT_ARTICLES=18
GUD_MAX_LLM_TOKENS_PER_EDITION=6000
# Prices must be deliberately configured; dashboard does not invent costs.
GUD_LLM_INPUT_USD_PER_1M=
GUD_LLM_OUTPUT_USD_PER_1M=
# LOCAL PREVIEW ONLY. Never enable on production.
GUD_ALLOW_ON_DEMAND_BUILD=false
# Only for separately validated model; synthetic bootstrap remains advisory.
GUD_ML_HARD_FILTER=false
